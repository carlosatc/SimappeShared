<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<parent>
		<groupId>org.springframework.boot</groupId>
		<artifactId>spring-boot-starter-parent</artifactId>
		<version>4.1.0</version>
		<relativePath />
	</parent>
	<groupId>com.catcsoft.simappe</groupId>
	<artifactId>SimappeShared</artifactId>
	<version>4.0.0</version>
	<name>SimappeShared</name>
	<description>
		SimappeShared - Proxy de los servicios Simappe

		Interfaces de cliente HTTP (@HttpExchange) de cada servicio Simappe, una de cada tipo:
		XxxBlockingClient (RestClient) y XxxReactiveClient (WebClient), con sus fabricas
		autoconfiguradas. Los contratos de datos viven en SimappeModel.
	</description>

	<properties>
		<java.version>25</java.version>
		<simappe-model.version>5.0.0</simappe-model.version>
		<simappe-commons.version>7.0.0</simappe-commons.version>
	</properties>

	<dependencies>
		<!-- Spring Boot core (autoconfiguration support) -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter</artifactId>
		</dependency>
		<!-- Clientes HTTP: opcionales, cada servicio trae el suyo (RestClient para la variante
		     bloqueante, WebClient para la reactiva) -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-restclient</artifactId>
			<optional>true</optional>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-webclient</artifactId>
			<optional>true</optional>
		</dependency>

		<!-- Web (RestTemplate) -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-webmvc</artifactId>
			<optional>true</optional>
		</dependency>

		<!-- Configuration processor for IDE autocomplete -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-configuration-processor</artifactId>
			<optional>true</optional>
		</dependency>

		<!-- Lombok -->
		<dependency>
			<groupId>org.projectlombok</groupId>
			<artifactId>lombok</artifactId>
			<optional>true</optional>
		</dependency>

		<!-- SimappeCommons core (SimappeConstant, SimappeException; provided: el consumidor ya la trae
		     por simappe-commons-servlet o simappe-commons-reactive) -->
		<dependency>
			<groupId>com.catcsoft.simappe</groupId>
			<artifactId>simappe-commons-core</artifactId>
			<version>${simappe-commons.version}</version>
			<scope>provided</scope>
		</dependency>

		<!-- JPA para ConsecutivoDbGateway (opt-in con simappe.consecutivo.db.enabled); antes llegaba
		     por simappe-commons-servlet -->
		<dependency>
			<groupId>jakarta.persistence</groupId>
			<artifactId>jakarta.persistence-api</artifactId>
			<optional>true</optional>
		</dependency>
		<!-- SimappeModel (DTOs) -->
		<dependency>
			<groupId>com.catcsoft.simappe</groupId>
			<artifactId>SimappeModel</artifactId>
			<version>${simappe-model.version}</version>
		</dependency>

		<!-- Test -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-test</artifactId>
			<scope>test</scope>
		</dependency>
	</dependencies>

	<build>
		<plugins>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-compiler-plugin</artifactId>
				<configuration>
					<source>25</source>
					<target>25</target>
					<compilerArgs>
						<arg>-parameters</arg>
					</compilerArgs>
					<annotationProcessorPaths>
						<path>
							<groupId>org.springframework.boot</groupId>
							<artifactId>spring-boot-configuration-processor</artifactId>
							<version>${spring-boot.version}</version>
						</path>
						<path>
							<groupId>org.projectlombok</groupId>
							<artifactId>lombok</artifactId>
							<version>${lombok.version}</version>
						</path>
					</annotationProcessorPaths>
				</configuration>
			</plugin>
		</plugins>
	</build>

	<!-- Repositorio para descargar dependencias: AWS CodeArtifact de Catcsoft -->
	<repositories>
		<repository>
			<id>catcsoft-ecosystem-catc</id>
			<name>AWS CodeArtifact Catcsoft (ecosystem-catc)</name>
			<url>https://catcsoft-803164160062.d.codeartifact.us-east-1.amazonaws.com/maven/ecosystem-catc/</url>
		</repository>
	</repositories>

	<!-- Perfiles de distribucion: CodeArtifact de Catcsoft (por defecto) y Nexus Centrica -->
	<profiles>
		<!-- Perfil para AWS CodeArtifact de Catcsoft - Activo por defecto -->
		<profile>
			<id>codeartifact</id>
			<activation>
				<activeByDefault>true</activeByDefault>
			</activation>
			<distributionManagement>
				<repository>
					<id>catcsoft-ecosystem-catc</id>
					<name>catcsoft-ecosystem-catc-releases</name>
					<url>https://catcsoft-803164160062.d.codeartifact.us-east-1.amazonaws.com/maven/ecosystem-catc/</url>
				</repository>
				<snapshotRepository>
					<id>catcsoft-ecosystem-catc</id>
					<name>catcsoft-ecosystem-catc-snapshots</name>
					<url>https://catcsoft-803164160062.d.codeartifact.us-east-1.amazonaws.com/maven/ecosystem-catc/</url>
				</snapshotRepository>
			</distributionManagement>
		</profile>

		<!-- Perfil para Nexus Centrica (soporte de licencia) - Activar con: mvn deploy -P centrica -->
		<profile>
			<id>centrica</id>
			<distributionManagement>
				<repository>
					<id>nexus-centrica</id>
					<name>Nexus Centrica Releases</name>
					<url>https://nexus.centricasoluciones.com/repository/centrica/</url>
				</repository>
				<snapshotRepository>
					<id>nexus-centrica</id>
					<name>Nexus Centrica Snapshots</name>
					<url>https://nexus.centricasoluciones.com/repository/centrica/</url>
				</snapshotRepository>
			</distributionManagement>
		</profile>
	</profiles>
</project>
